# Generated by Ansible from group_vars/all/cluster.yml
# Host: {{ inventory_hostname }}
network:
  version: 2
{% if netplan_renderer | default('') | length > 0 %}
  renderer: {{ netplan_renderer }}
{% endif %}
  ethernets:
    mgmt0:
      match:
        name: "{{ runtime_network.interface }}"
      set-name: "{{ runtime_network.interface }}"
      dhcp4: false
      addresses:
        - "{{ node_cfg.runtime_mgmt_ip }}/{{ runtime_network.prefix }}"
      routes:
        - to: default
          via: "{{ runtime_network.gateway }}"
      nameservers:
        addresses:
{% for dns in runtime_network.dns %}
          - "{{ dns }}"
{% endfor %}
{% for rail in resolved_backend_rails %}
    L{{ rack_pair_id }}R{{ node_cfg.rack }}N{{ node_cfg.node }}S{{ rail.slot }}:
      match:
        name: "{{ rail.physical_name }}"
      set-name: "L{{ rack_pair_id }}R{{ node_cfg.rack }}N{{ node_cfg.node }}S{{ rail.slot }}"
      dhcp4: false
      mtu: {{ netplan_mtu }}
      addresses:
        - "192.168.{{ (fabric_cfg.subnet_base | int) + (rail.lane | int) }}.{{ backend_host_octet }}/24"
      routes:
{% set local_pair = rack_pair_id | int %}
{% for pair_id, pair in backend_fabric_pairs.items() %}
{% if pair_id | int != local_pair %}
        - to: "192.168.{{ (pair.subnet_base | int) + (rail.lane | int) }}.0/24"
          via: "192.168.{{ (fabric_cfg.subnet_base | int) + (rail.lane | int) }}.254"
{% endif %}
{% endfor %}
{% endfor %}
